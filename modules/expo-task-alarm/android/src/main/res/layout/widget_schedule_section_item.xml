<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_section_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="6dp"
    android:paddingRight="6dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/widget_section_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginRight="7dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:letterSpacing="0.05"
        android:singleLine="true"
        android:text="TODAY • FRI, NOV 27"
        android:textColor="#A0A0B2"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_section_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="2 due"
        android:textColor="#8E8E9E"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
