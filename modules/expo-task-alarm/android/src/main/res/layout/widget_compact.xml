<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_compact_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_rounded_24"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp">

        <!-- Left Google Calendar-style Date Tile -->
        <FrameLayout
            android:id="@+id/widget_compact_date_tile"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginRight="10dp">

            <ImageView
                android:id="@+id/widget_compact_date_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_rounded_16"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_compact_dow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:singleLine="true"
                    android:text="FRI"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_compact_day_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:singleLine="true"
                    android:text="27"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Center Up-Next Task & Progress Info -->
        <LinearLayout
            android:id="@+id/widget_compact_center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_compact_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:singleLine="true"
                android:text="UP NEXT • 0 DUE"
                android:textColor="#6C5CE7"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_compact_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="All caught up for today!"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_compact_task_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Tap + to schedule a new task"
                android:textColor="#9A9AAE"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Direct Complete Check-off Button -->
        <FrameLayout
            android:id="@+id/widget_compact_check_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp">

            <ImageView
                android:id="@+id/widget_compact_check_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_compact_check_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Quick Add + Button -->
        <FrameLayout
            android:id="@+id/widget_compact_add_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp">

            <ImageView
                android:id="@+id/widget_compact_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_compact_add_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="2dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
