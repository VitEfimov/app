<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_task_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_rounded_12"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="7dp"
        android:paddingRight="10dp"
        android:paddingBottom="7dp">

        <!-- Google Calendar-style Left Vertical Priority / Board Color Bar -->
        <ImageView
            android:id="@+id/widget_task_accent_bar"
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:layout_marginRight="6dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_shape_accent_bar"
            android:contentDescription="@null" />

        <!-- Direct Home-Screen Check-off Button -->
        <FrameLayout
            android:id="@+id/widget_task_check_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="6dp"
            android:padding="4dp">

            <ImageView
                android:id="@+id/widget_task_check_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_circle_ring"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_task_check_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_shape_circle"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_task_check_mark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Task Title, Subtitle Metadata & Specialized Board Badge -->
        <LinearLayout
            android:id="@+id/widget_task_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_task_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Task Title"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/widget_task_badge_wrap"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp">

                    <ImageView
                        android:id="@+id/widget_task_badge_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_shape_pill"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_task_badge_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp"
                        android:singleLine="true"
                        android:text="11:30 AM"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_task_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Today • Main Board"
                android:textColor="#9A9AAE"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
