<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1716"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:gravity="center">

        <TextView
            android:id="@+id/alarm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="04:47"
            android:textColor="#FCEEE6"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="4"
            android:includeFontPadding="false"
            android:layout_marginHorizontal="24dp" />

        <TextView
            android:id="@+id/alarm_task_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alarm"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="32dp"
        android:layout_marginBottom="64dp"
        android:gravity="center">

        <Button
            android:id="@+id/alarm_snooze_button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_snooze"
            android:text="Snooze"
            android:textColor="#42301B"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/alarm_dismiss_button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_stop"
            android:text="Stop"
            android:textColor="#F3D5CA"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</RelativeLayout>
