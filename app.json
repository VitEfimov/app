{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitvalef.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vitvalef.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "395d86c4-8f1b-43b7-8153-4ac272e2e688"
      }
    },
    "plugins": [
      "./withAndroidImageCropperFix.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayTasksWidget",
              "label": "Today's Tasks",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "View your tasks for today",
              "updatePeriodMillis": 86400000
            }
          ]
        }
      ],
      [
        "react-native-widget-extension",
        {
          "frequentUpdates": false,
          "widgetsFolder": "targets/widgets"
        }
      ]
    ]
  }
}
