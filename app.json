{
  "expo": {
    "name": "TD",
    "slug": "app",
    "version": "1.0.0",
    "scheme": "taskmanager",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitvalef.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vitvalef.app",
      "backgroundColor": "#121212",
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "permissions": [
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "ACCESS_NOTIFICATION_POLICY",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "395d86c4-8f1b-43b7-8153-4ac272e2e688"
      }
    },
    "plugins": [
      "./modules/expo-task-alarm/app.plugin.js",
      "./withAndroidImageCropperFix.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/alarm_02.mp3",
            "./assets/audio/alarm_gentle.wav",
            "./assets/audio/alarm_gentle_loop.wav",
            "./assets/audio/alarm_urgent.wav",
            "./assets/audio/alarm_urgent_loop.wav",
            "./assets/audio/alarn_03.mp3",
            "./assets/audio/bamboo.mp3",
            "./assets/audio/bass_alarm.mp3",
            "./assets/audio/bell.mp3",
            "./assets/audio/bell01.mp3",
            "./assets/audio/chime.wav",
            "./assets/audio/end_sound.ogg",
            "./assets/audio/fireworks.mp3",
            "./assets/audio/konb.mp3",
            "./assets/audio/konob.mp3",
            "./assets/audio/konob2.mp3",
            "./assets/audio/kot.mp3",
            "./assets/audio/koto.mp3",
            "./assets/audio/koto_alarm.mp3",
            "./assets/audio/koto_notification.mp3",
            "./assets/audio/koto_shamisen.mp3",
            "./assets/audio/light_ping.wav",
            "./assets/audio/light_scrub.mp3",
            "./assets/audio/low_piano.mp3",
            "./assets/audio/morning_glass.wav",
            "./assets/audio/notification.wav",
            "./assets/audio/notification_air.wav",
            "./assets/audio/notification_focus.wav",
            "./assets/audio/notification_priority.wav",
            "./assets/audio/notification_soft.wav",
            "./assets/audio/overdue_nudge.wav",
            "./assets/audio/reminder_soft.wav",
            "./assets/audio/sakura.mp3",
            "./assets/audio/shamisen.mp3",
            "./assets/audio/shrine_bell.mp3",
            "./assets/audio/start_sound.mp3",
            "./assets/audio/success_bloom.wav",
            "./assets/audio/task_complete.wav",
            "./assets/audio/warning_gentle.wav"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-share-intent",
        {
          "customScheme": "taskmanager"
        }
      ]
    ]
  }
}